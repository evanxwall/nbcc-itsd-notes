<!-- Noticed we are not binding anything -->
@{
    ViewBag.Title = "Create";
    // Pretend user is making a new product 
    // Proof Of Concept - Data is being sent to the controller
}

<h2>Create</h2>

<form action="/Products/Create" method="post">
    <div class="form-group">
        <label>Product Id</label>
        <input type="text" class="form-control" id="txtProductid" placeholder="ProductID" name="ProductId" />
    </div>
    <div class="form-group">
        <label>Product Name</label>
        <input type="text" class="form-control" id="txtProductName" placeholder="Product Name" name="ProductName" />
    </div>
    <div class="form-group">
        <label>Rate</label>
        <input type="text" class="form-control" id="txtRate" placeholder="Rate" name="Rate" />
    </div>
    <br />
    <div>
        <button class="btn btn-success">Submit</button>
    </div>
</form>

