# ============================================================
# College Coursework Repository - .gitignore
# Visual Studio / ASP.NET MVC 5 / VS Code / IntelliJ / Java
# Maven / Gradle / JavaScript / Node.js / C++ / CMake
# ============================================================
# Put this file at the ROOT of the repository.
# Patterns apply to nested coursework projects as well.

# --- Operating system / temporary files ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
~$*
*.tmp
*.temp
*.bak
*.swp
*.swo

# --- Secrets and local environment settings ---
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.publishsettings
*.pubxml.user
secrets.json

# --- Visual Studio / C# / ASP.NET MVC ---
.vs/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Tt]est[Rr]esult*/
[Bb]enchmarkDotNet.Artifacts/
[Bb]uild[Ll]og.*
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
*.pdb
*.mdb
*.ilk
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.binlog
*.cache
*.log
*.coverage
*.coveragexml
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
Generated\ Files/
_ReSharper*/
*.DotSettings.user
publish/
*.pubxml
*.azurePubxml

# --- NuGet (packages.config is intentionally tracked) ---
# Downloaded solution-level packages are restorable.
[Pp]ackages/

# --- VS Code ---
# Keep shareable workspace configuration but not personal settings.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/*.code-snippets
.history/
.localhistory/
*.vsix

# --- IntelliJ IDEA / JetBrains ---
# For Maven/Gradle coursework, pom.xml and build.gradle recreate project setup.
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/

# --- Java / Maven ---
**/target/
*.class
*.jar
*.war
*.ear
*.nar
# If a project intentionally uses local, non-restorable JARs, add an exception.

# --- Gradle ---
.gradle/
**/build/
!**/src/**/build/

# --- JavaScript / Node.js ---
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
coverage/
.nyc_output/
.next/
.nuxt/
.svelte-kit/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Keep package.json and lockfiles for reproducible installs.

# --- C++ / CMake ---
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.obj
*.pch
*.ilk
*.idb
*.tlog
*.VC.db
*.VC.opendb
*.opendb
*.sdf
*.opensdf
ipch/
# Do not ignore Makefile globally: hand-written Makefiles are source files.

# --- Local databases and generated runtime state ---
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal

# --- Python (occasional scripts or utilities) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Notes, course materials and project sources: KEEP ---
# Markdown, PDFs, Word files, screenshots, images, and source files
# are not ignored. Use Git LFS selectively for large binary assets.
# Also keep: *.sln, *.slnx, *.csproj, packages.config,
# pom.xml, build.gradle, gradlew, gradle/wrapper/, package-lock.json.
